{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "facebook-ads-codex-offline",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-05",
  "compatibility_flags": ["nodejs_compat"],

  // This configuration is deliberately local-only while G0 is PARTIAL.
  // The placeholder database ID makes remote deployment invalid by design.
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "OFFLINE_FIXTURES_ENABLED": "true"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "facebook-ads-codex-offline",
      "database_id": "LOCAL_ONLY_DO_NOT_DEPLOY",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  }
}
