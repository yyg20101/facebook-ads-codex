{
  "config": {
    // Chinese prose, tables, and canonical identifiers are not wrapped at 80 columns.
    "MD013": false,
    // The execution spec carries a front matter title and one visible H1.
    "MD025": {
      "front_matter_title": ""
    }
  },
  "globs": [
    "**/*.md",
    "#node_modules"
  ]
}
